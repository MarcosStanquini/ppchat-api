  "requisitos_gerais": [
    {
      "item": "Integralização",
      "descricao": "Integralização mínima em 5 semestres e máxima em 10 semestres. Carga horária mínima de 1786,9 h (1666,9 h em componentes obrigatórios presenciais + 120 h de TCC) e máxima de 1820,2 h (com a optativa LIBRAS, 33,3 h). Diploma de Tecnólogo em Processos Gerenciais ao integralizar todos os componentes obrigatórios.",
      "pagina": 27
    },
    {
      "item": "Trabalho de Conclusão de Curso (TCC)",
      "descricao": "Atividade curricular obrigatória de 120 horas, em forma de monografia ou relatório técnico, sem pré-requisitos. Aspectos metodológicos no 2º módulo; a partir do 3º módulo o aluno conta com orientador docente do eixo de gestão até a entrega e apresentação final. Regras no Manual do TCC (Colegiado de Curso). Resultado registrado como cumpriu/não cumpriu.",
      "pagina": 32
    },
    {
      "item": "Estágio Curricular Supervisionado",
      "descricao": "Facultativo (optativo). Quando realizado, deve totalizar 120 horas no histórico, com atividades correlatas ao curso, Relatório de atividades assinado, Professor Orientador do IFSP e Supervisor na empresa; coordenado pela Coordenadoria de Extensão (CEX). Segue o Regulamento de Estágio do IFSP (Portaria 1204/2011) e a Lei 11.788/2008.",
      "pagina": 31
    },
    {
      "item": "Curricularização da Extensão",
      "descricao": "200 horas de extensão (11,2% da carga mínima; mínimo legal de 10%), cumpridas nos componentes obrigatórios Introdução à Extensão (33,3 h, 1º sem.), Extensão 1 (66,7 h, 2º sem.), Extensão 2 (66,7 h, 3º sem.) e Extensão 3 (33,3 h, 4º sem.), vinculados a projeto de extensão curricularizada.",
      "pagina": 26
    },
    {
      "item": "Aprovação nos componentes",
      "descricao": "Aprovado com nota semestral ≥ 6,0 e frequência mínima de 75%. Com nota entre 4,0 e 6,0 e frequência ≥ 75%, faz Instrumento Final de Avaliação e precisa de nota ≥ 6,0 nele.",
      "pagina": 43
    }
  ]
