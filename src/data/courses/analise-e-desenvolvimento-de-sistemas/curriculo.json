  "requisitos_gerais": [
    {
      "item": "Integralização do curso",
      "descricao": "Carga horária total mínima de 2000,4 horas em componentes obrigatórios (1767,0 h de ensino + 233,4 h de extensão), cursada em no mínimo 6 e no máximo 12 semestres; semestre de 20 semanas e aulas de 50 minutos. A carga máxima chega a 2167 horas com as optativas (LIBRAS e Metodologia de Pesquisa Científica, 33,3 h cada) e o TCC (100 h).",
      "pagina": 22
    },
    {
      "item": "Curricularização da Extensão",
      "descricao": "233,4 horas de extensão (11,7% da carga mínima; mínimo legal de 10%) cumpridas nos componentes obrigatórios Atividades de Extensão 1 (SCLAXD1, 4º sem., 66,7 h), 2 (SCLAXD2, 5º sem., 66,7 h) e 3 (SCLAXD3, 6º sem., 100 h), vinculados a projetos de extensão com a comunidade de no mínimo um semestre letivo.",
      "pagina": 43
    },
    {
      "item": "Estágio Curricular Supervisionado",
      "descricao": "Optativo, sem carga horária mínima exigida. Se realizado, exige orientador docente do IFSP e supervisor na empresa, formulários junto à coordenação de extensão, relatórios parciais e relatório final; recebe menção Aprovado/Reprovado e é registrado no histórico.",
      "pagina": 29
    },
    {
      "item": "Trabalho de Conclusão de Curso (TCC)",
      "descricao": "Optativo, com carga horária de 100 horas; exige monografia defendida perante banca, com menção Aprovado/Reprovado. O PPC sugere cursar Metodologia de Pesquisa Científica (SCLMPQC) a quem optar pelo TCC.",
      "pagina": 31
    },
    {
      "item": "Pré-requisitos",
      "descricao": "Os componentes listados no Quadro 2 só podem ser cursados com aprovação prévia nos pré-requisitos indicados; ex.: Atividades de Extensão 1 exige Programação Orientada a Objetos, Banco de Dados 1, Programação para Web 1 e Interação Humano-Computador.",
      "pagina": 28
    },
    {
      "item": "Diploma",
      "descricao": "O diploma de Tecnólogo em Análise e Desenvolvimento de Sistemas é concedido a quem integralizar todos os componentes curriculares obrigatórios.",
      "pagina": 129
    }
  ]
