ANTHROPIC_API_KEY=""

# Chat: Haiku 5.5 é o mais barato (US$ 0,10 / US$ 0,50 por 1M tokens até 100K de prompt;
# US$ 0,50 / US$ 2,50 acima disso). Para respostas melhores, troque por claude-sonnet-5-5 (US$ 2 / US$ 10).
LLM_MODEL="claude-haiku-5-5"

# Extração do currículo: roda uma vez por PDF, então vale um modelo melhor (~US$ 0,30 por ingestão)
EXTRACTION_MODEL="claude-sonnet-5-5"

# Usado só se o modelo do chat recusar a pergunta
FALLBACK_MODEL="claude-sonnet-5-5"

# Esforço de raciocínio: low | medium | high | xhigh | max
CHAT_EFFORT="medium"
EXTRACTION_EFFORT="high"

# Proteção dos créditos quando o site é público (0 desliga)
RATE_LIMIT_PER_HOUR=30
GLOBAL_RATE_LIMIT_PER_HOUR=400

# Origens do SUAP de onde o bookmarklet pode enviar os dados do aluno
SUAP_ORIGINS='["https://suap.ifsp.edu.br"]'
